---
// Homepage-index, shared by every language. Career and CV become links
// when their pages land (#4); until then they are plain text.
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
import { ui, type Lang } from "../i18n/ui";
import { localizedPath } from "../i18n/routes";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].home;
---

<Base lang={lang} route="home" title={t.title} description={t.description}>
  <h1>{t.title}</h1>
  <p>{t.intro}</p>
  <ul>
    <li><a href={localizedPath(lang, "projects")}>{t.links.projects}</a></li>
    <li>{t.links.career}</li>
    <li>{t.links.cv}</li>
    <li><a href={profile.linkedin}>{t.links.linkedin}</a></li>
    <li><a href={profile.github}>{t.links.github}</a></li>
    <li><a href={`mailto:${profile.email}`}>{t.links.email}</a></li>
  </ul>
</Base>
