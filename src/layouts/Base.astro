---
// Shared shell for every page: lang, title, description, canonical and hreflang alternates
// (en, it, x-default), derived from the page's route key. Pages only pass `route`, `lang` and copy.
import "../styles/global.css";
import { defaultLang, languages, ui, type Lang } from "../i18n/ui";
import { localizedPath, type RouteKey } from "../i18n/routes";

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
}

const { lang, route, title, description } = Astro.props;
const absolute = (l: Lang) => new URL(localizedPath(l, route), Astro.site).href;
const other = languages.find((l) => l !== lang)!;
// "Last updated" is the build date: every deploy publishes the current content.
const lastUpdated = new Intl.DateTimeFormat(ui[lang].locale, { month: "long", year: "numeric" }).format(new Date());
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute(lang)} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={absolute(l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(defaultLang)} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <p>{ui[lang].footer.lastUpdated}: {lastUpdated}</p>
      <p>
        <a href={localizedPath(other, route)} hreflang={other} lang={other}>{ui[other].languageName}</a>
      </p>
    </footer>
  </body>
</html>
