---
// Shared shell for every page: lang, title, description, canonical and hreflang alternates
// (en, it, x-default), derived from the page's route key. Pages only pass `route`, `lang` and copy.
// A page without a route key (the not-found page) has no URL of its own: it gets `noindex`,
// no canonical, no hreflang and no language switch, and stays out of the sitemap.
import "../styles/global.css";
import { languages, ui, type Lang } from "../i18n/ui";
import { absoluteUrl, alternates, localizedPath, type RouteKey } from "../i18n/routes";
import { profile } from "../data/profile";
import { siteData } from "../data/site";
import Analytics from "@vercel/analytics/astro";

interface Props {
  lang: Lang;
  route?: RouteKey;
  title: string;
  description: string;
}

const { lang, route, title, description } = Astro.props;
const absolute = (path: string) => absoluteUrl(path, Astro.site);
const canonical = route && absolute(localizedPath(lang, route));
// The footer links to the same page in every other language (only Italian, for an English page).
const otherLangs = languages.filter((l) => l !== lang);
// One static preview image for every page and language (generated by scripts/og-image.mjs).
const ogImage = absolute("/og.png");
const ogImageAlt = `${profile.name}, ${profile.jobTitle}`;
// "Last updated" is when the content last changed (src/data/site.ts), not the build date.
const [year, month] = siteData.lastUpdated.split("-").map(Number);
const lastUpdated = new Intl.DateTimeFormat(ui[lang].locale, { month: "long", year: "numeric", timeZone: "UTC" }).format(
  new Date(Date.UTC(year, month - 1, 1)),
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={ui[lang].ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {
      route ? (
        <>
          <link rel="canonical" href={canonical} />
          {alternates(route).map((a) => <link rel="alternate" hreflang={a.hreflang} href={absolute(a.path)} />)}
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <Analytics />
    <main>
      <slot />
    </main>
    <footer>
      <p>{ui[lang].footer.lastUpdated}: {lastUpdated}</p>
      {
        route &&
          otherLangs.map((other) => (
            <p>
              <a href={localizedPath(other, route)} hreflang={other} lang={other}>{ui[other].languageName}</a>
            </p>
          ))
      }
    </footer>
  </body>
</html>
